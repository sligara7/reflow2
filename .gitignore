__pycache__/
*.pyc

# Rust
# Any cargo target dir, at any depth — NOT just the workspace root.
#
# It was `/target` until 2026-08-24, which ignores the root one only. A test
# that wrote fixtures under `crates/reflow2-core/target/` therefore had them
# picked up by `git add -A` and merged to main in #322. Cargo puts a target dir
# wherever it is invoked, so the pattern has to be depth-agnostic.
target/

# Self-host: reflow2's own graph is a RocksDB directory, and the agent MCP
# configs (.mcp.json, opencode.json, .vscode/mcp.json) carry absolute paths to a
# local build. All are per-machine, not shared state.
/.reflow2/
/.mcp.json
/opencode.json
/.vscode/mcp.json


# Trial records about real systems (storyflow, ophyd-service, personal projects)
# stay out of the public repo: they describe designs that are not reflow2's to
# publish. Kept locally; the public evidence base is the reflow2-self trials.
/docs/trials-private/

# reflow2's local design graph (machine state; the durable record is an export)
.reflow2/
# reflow2's MCP configs — they carry an absolute path to YOUR binary
.mcp.json
opencode.json
.vscode/mcp.json
# reflow2's loop-nudge hook — an absolute path to YOUR kit
.claude/settings.local.json

# Inbound field reports from projects that use reflow2 — kept on the author's
# machine, never committed (dec:field-reports-are-untracked-because-the-
# repository-is-public, 2026-09-02). This repository is PUBLIC and some of the
# reporting projects are proprietary. The design still registers each report
# and captures its findings; only the document stays out.
docs/feedback/

# Local operator notes — machine names, accounts, paths. PUBLIC REPO: never commit.
docs/local/
