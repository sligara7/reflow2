{
  "annotations": {
    "readOnlyHint": true
  },
  "description": "Quality-dimension drift for one target node.",
  "inputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
      "dimension": {
        "description": "Quality dimension key (e.g. `reliability`, `security`).",
        "enum": [
          "reliability",
          "performance",
          "maintainability",
          "security",
          "scalability",
          "observability",
          "testability",
          "coupling",
          "maturity"
        ],
        "type": "string"
      },
      "target_id": {
        "description": "The assessed node — any node type carrying `HAS_OBSERVATION` edges\nto `DimensionObservation` records.",
        "type": "string"
      }
    },
    "required": [
      "target_id",
      "dimension"
    ],
    "type": "object"
  },
  "name": "dimension_drift"
}
